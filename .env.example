# ==========================================
# CREDENCIALES DE FIREBASE (PROYECTO MELI)
# ==========================================
# Obtenelas en: Consola de Firebase -> Configuración del Proyecto -> General -> Tus apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ==========================================
# SEGURIDAD Y ACCESO ADMIN
# ==========================================
# Email o lista de emails autorizados (separados por coma) para entrar a /admin
VITE_ADMIN_EMAIL=admin@mercadolibreafiliados.com

# ==========================================
# INTEGRACIÓN CANAL DE TELEGRAM
# ==========================================
# Obtené el Token hablando con @BotFather en Telegram
VITE_TELEGRAM_BOT_TOKEN=
# Chat ID del canal o grupo (ej: @ofertas_meli_ar o -1001234567890)
VITE_TELEGRAM_CHAT_ID=
